{
	"name": "@empyria/mcp",
	"version": "0.1.8",
	"description": "MCP (Model Context Protocol) helpers for the Empyria nanoservice framework",
	"license": "MIT",
	"author": "Imre Fazekas <imre.fazekas@icloud.com>",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/empyria-nano/guard-mcp.git"
	},
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./lib/*": "./lib/*.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"format": "bun oxfmt --check",
		"format:fix": "bun oxfmt",
		"lint": "bun oxlint",
		"lint:fix": "bun oxlint --fix",
		"test": "bun test --coverage",
		"test:watch": "bun test --watch"
	},
	"dependencies": {
		"@empyria/classification": "0.1.5",
		"@empyria/common": "0.1.8",
		"@modelcontextprotocol/client": "2.0.0",
		"@modelcontextprotocol/server": "2.0.0"
	},
	"devDependencies": {
		"oxfmt": "0.66.0",
		"oxlint": "1.81.0"
	},
	"engines": {
		"bun": ">=1.4.0",
		"node": ">=26"
	},
	"packageManager": "bun@1.4.2"
}
